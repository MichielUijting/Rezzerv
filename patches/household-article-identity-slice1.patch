--- /dev/null
+++ b/frontend/src/features/stores/householdArticleIdentity.single-source.contract.test.js
@@ -0,0 +1,27 @@
+import fs from 'node:fs'
+import path from 'node:path'
+import { describe, expect, it } from 'vitest'
+
+const root = path.resolve(process.cwd())
+const auth = fs.readFileSync(path.join(root, 'src/lib/authSession.js'), 'utf8')
+const page = fs.readFileSync(path.join(root, 'src/features/stores/StoreBatchDetailPage.jsx'), 'utf8')
+
+describe('Huishoudartikel single-source slice 1', () => {
+  it('verwijdert verborgen artikel-ID-normalisatie uit de globale auth/fetch-laag', () => {
+    expect(auth).not.toContain('normalizeHouseholdArticleOptionsPayload')
+    expect(auth).not.toContain('shouldNormalizeHouseholdArticleOptions')
+    expect(auth).not.toContain('store-review-articles')
+  })
+
+  it('begrenst tijdelijke compatibiliteitsnormalisatie tot Uitpakken', () => {
+    expect(page).toContain('normalizeHouseholdArticleOptionsPayload(backendArticles)')
+    expect(page).toContain('canonicalArticleItems')
+  })
+
+  it('blijft echte household_article_id gebruiken voor B2/B3/B4', () => {
+    expect(page).toContain('line?.matched_household_article_id')
+    expect(page).toContain('fetchInventoryHandlingByArticleIds')
+  })
+})
