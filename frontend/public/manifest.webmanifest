{
  "id": "/",
  "name": "Inhuis",
  "short_name": "Inhuis",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#e8f5e9",
  "theme_color": "#005F6A",
  "description": "Inhuis kassabon-inname en voorraadbeheer",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/inhuis-app-icon-brand-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/inhuis-app-icon-brand-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/api/receipts/share-target?household_id=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "receipt",
          "accept": ["application/pdf", "image/png", "image/jpeg", "image/webp"]
        }
      ]
    }
  }
}
